@model AbibiFood.Api.Controllers.LoginInput
@{ViewData["Title"]="ورود مدیریت";}
<div class="admin-card mx-auto" style="max-width:440px"><form asp-action="Login" method="post"><div asp-validation-summary="All" class="text-danger"></div><label asp-for="Email" class="form-label">ایمیل</label><input asp-for="Email" type="email" class="form-control mb-3" autocomplete="username"><label asp-for="Password" class="form-label">رمز عبور</label><input asp-for="Password" class="form-control mb-3" autocomplete="current-password"><button class="btn btn-primary w-100">ورود</button></form></div>