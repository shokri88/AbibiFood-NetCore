@model ImageInput
@{ViewData["Title"]="تصاویر «" + ViewData["FoodName"] + "»";}
<a asp-action="Foods" asp-route-id="@Model.FoodId" class="btn btn-outline-primary mb-3">بازگشت به غذا</a>
<p class="alert alert-info">ترتیب نمایش ۰ را برای تصویر اصلی فعال غذا قرار دهید؛ این تصویر در فهرست و کارت غذا نمایش داده می‌شود. برای تصاویر بعدی ترتیب‌های ۱، ۲ و بالاتر تعیین کنید؛ این تصاویر در صفحه جزئیات اپ دیده می‌شوند. برای هر ترتیب فقط یک تصویر فعال قرار دهید.</p>
<section class="admin-card mb-4">
    <h2 class="card-heading">@(Model.Id == 0 ? "افزودن تصویر" : "ویرایش تصویر")</h2>
    <form asp-action="SaveImage" method="post" enctype="multipart/form-data">
        <input asp-for="Id" type="hidden"><input asp-for="FoodId" type="hidden">
        <div class="row g-3">
            <div class="col-12 col-md-4">
                <label for="imageFile" class="form-label">انتخاب تصویر از سیستم</label>
                <input type="file" id="imageFile" name="imageFile" class="form-control" accept="image/png,image/jpeg,image/webp" data-image-upload required="@(Model.Id == 0)">
                <p class="small text-secondary mt-2">PNG، JPEG یا WebP؛ حداکثر ۵ مگابایت. هنگام ویرایش، انتخاب فایل اختیاری است.</p>
                @if(Model.Id > 0){<img src="@Model.Path" alt="تصویر فعلی غذا" class="image-preview">}
            </div>
            <div class="col-12 col-md-4"><label asp-for="SortOrder" class="form-label">ترتیب نمایش</label><input asp-for="SortOrder" class="form-control" type="number"></div>
            <div class="col-12 col-md-4"><label class="form-check check-field"><input asp-for="IsActive" class="form-check-input">تصویر فعال</label></div>
            <div class="col-12 form-footer"><button class="btn btn-primary">ذخیره تصویر</button></div>
        </div>
    </form>
</section>

<section class="admin-card">
    <h2 class="card-heading">تصاویر ثبت‌شده</h2>
    @if(Model.Id > 0){<a asp-action="Images" asp-route-foodId="@Model.FoodId" class="btn btn-outline-primary mb-3">تصویر جدید</a>}
    <div class="table-responsive"><table class="table"><thead><tr><th data-no-sort>تصویر</th><th>ترتیب</th><th>فعال</th><th data-no-sort>عملیات</th></tr></thead><tbody>
    @foreach(var image in (ViewData["Images"] as List<FoodImage> ?? [])){
        <tr><td><img src="@image.Path" class="image-thumb" alt="تصویر غذا" loading="lazy"></td><td>@image.SortOrder</td><td>@(image.IsActive ? "فعال" : "غیرفعال")</td><td><div class="row-actions">
        <a asp-action="Images" asp-route-foodId="@Model.FoodId" asp-route-id="@image.Id" class="btn btn-outline-primary btn-sm">ویرایش</a>
        <partial name="_DeleteButton" model='new DeleteButton("FoodImage", image.Id.ToString(), "/Admin/Images?foodId=" + Model.FoodId)'/>
        </div></td></tr>
    }
    </tbody></table></div>
</section>
