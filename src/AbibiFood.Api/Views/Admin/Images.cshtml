@model ImageInput
@{ViewData["Title"]="تصاویر غذا";}
<section class="admin-card"><form asp-action="SaveImage" method="post"><div asp-validation-summary="All" class="text-danger"></div><input asp-for="Id" type="hidden"><input type="hidden" name="branchId" value="@ViewData["BranchId"]"><div class="row g-3"><div class="col-md-6"><label asp-for="FoodId" class="form-label">غذا</label><select asp-for="FoodId" class="form-select">@foreach(var option in (ViewData["Foods"] as List<Food> ?? [])){<option value="@option.Id">@option.Name</option>}</select></div><div class="col-md-6"><label asp-for="Path" class="form-label">مسیر تصویر مانند /assets/image/logo.webp</label><input asp-for="Path" type="text" class="form-control"><span asp-validation-for="Path" class="text-danger"></span></div><div class="col-md-6"><label asp-for="SortOrder" class="form-label">ترتیب</label><input asp-for="SortOrder" type="number" class="form-control" step="any"><span asp-validation-for="SortOrder" class="text-danger"></span></div><div class="col-md-6"><label class="form-check"><input asp-for="IsActive" class="form-check-input">فعال</label></div><div class="col-12"><button class="btn btn-primary">ذخیره</button></div></div></form><partial name="_Rows"/></section>