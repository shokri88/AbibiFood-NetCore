@model BranchFoodInput
@{ViewData["Title"]="غذای شعبه";}
<partial name="_BranchFilter"/><section class="admin-card"><form asp-action="SaveBranchFood" method="post"><div asp-validation-summary="All" class="text-danger"></div><input asp-for="Id" type="hidden"><input type="hidden" name="branchId" value="@ViewData["BranchId"]"><div class="row g-3"><input asp-for="BranchId" type="hidden"><input asp-for="Version" type="hidden"><div class="col-md-6"><label asp-for="FoodId" class="form-label">غذای مخزن</label><select asp-for="FoodId" class="form-select">@foreach(var option in (ViewData["Foods"] as List<Food> ?? [])){<option value="@option.Id">@option.Name</option>}</select></div><div class="col-md-6"><label asp-for="Price" class="form-label">قیمت به تومان</label><input asp-for="Price" type="number" class="form-control" step="any"><span asp-validation-for="Price" class="text-danger"></span></div><div class="col-md-6"><label asp-for="DiscountPrice" class="form-label">قیمت تخفیفی اختیاری</label><input asp-for="DiscountPrice" type="number" class="form-control" step="any"><span asp-validation-for="DiscountPrice" class="text-danger"></span></div><div class="col-md-6"><label class="form-check"><input asp-for="CanSellStandalone" class="form-check-input">قابل فروش مستقل</label></div><div class="col-md-6"><label class="form-check"><input asp-for="IsActive" class="form-check-input">فعال</label></div><div class="col-12"><button class="btn btn-primary">ذخیره</button></div></div></form><partial name="_Rows"/></section>