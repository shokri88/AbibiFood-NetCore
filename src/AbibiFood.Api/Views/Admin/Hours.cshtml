@model HoursInput
@{ViewData["Title"]="ساعات شعبه";}
<partial name="_BranchFilter"/><section class="admin-card mb-4"><h2 class="card-heading">ثبت و ویرایش اطلاعات</h2><form asp-action="SaveHours" method="post"><div asp-validation-summary="All" class="text-danger"></div><input asp-for="Id" type="hidden"><input type="hidden" name="branchId" value="@ViewData["BranchId"]"><div class="row g-3"><input asp-for="BranchId" type="hidden"><div class="col-12 col-md-4 col-xl-3"><label class="form-label">نوع ساعت</label><select asp-for="Kind" asp-items="Html.GetEnumSelectList<HoursKind>()" class="form-select"></select></div><div class="col-12 col-md-4 col-xl-3"><label class="form-label">روز هفته</label><select asp-for="Day" asp-items="Html.GetEnumSelectList<DayOfWeek>()" class="form-select"></select></div><div class="col-12 col-md-4 col-xl-3"><label asp-for="Start" class="form-label">شروع</label><input asp-for="Start" type="time" class="form-control"><span asp-validation-for="Start" class="text-danger"></span></div><div class="col-12 col-md-4 col-xl-3"><label asp-for="End" class="form-label">پایان (کمتر از شروع یعنی روز بعد)</label><input asp-for="End" type="time" class="form-control"><span asp-validation-for="End" class="text-danger"></span></div><div class="col-12 col-md-4 col-xl-3"><label class="form-check check-field"><input asp-for="IsActive" class="form-check-input">فعال</label></div><div class="col-12"><button class="btn btn-primary">ذخیره</button></div></div></form></section>
<partial name="_Rows"/>