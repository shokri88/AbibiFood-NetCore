@model List<AuditLog>
@{ViewData["Title"]="لاگ عملیات و خطا";var errors=ViewData["Errors"] as List<ErrorLog> ?? [];}
<section class="admin-card"><h2 class="h5">۱۰۰ عملیات اخیر</h2><div class="table-responsive"><table class="table"><thead><tr><th>زمان تهران</th><th>کاربر</th><th>شعبه</th><th>عملیات</th><th>رکورد</th></tr></thead><tbody>@foreach(var x in Model){<tr><td data-sort="@x.OccurredAt.ToUnixTimeSeconds()">@PersianDisplay.Timestamp(x.OccurredAt)</td><td>@x.ActorId</td><td>@x.BranchId</td><td>@x.Action</td><td>@x.EntityType / @x.EntityId</td></tr>}</tbody></table></div></section><section class="admin-card mt-4"><h2 class="h5">۱۰۰ خطای اخیر</h2><div class="table-responsive"><table class="table"><thead><tr><th>زمان تهران</th><th>شناسه پیگیری</th><th>نوع خطا</th><th data-no-sort>جزئیات</th></tr></thead><tbody>@foreach(var e in errors){<tr><td data-sort="@e.OccurredAt.ToUnixTimeSeconds()">@PersianDisplay.Timestamp(e.OccurredAt)</td><td>@e.CorrelationId</td><td>@e.ExceptionType</td><td><details><summary>مشاهده جزئیات</summary><pre dir="ltr">@e.StackTrace</pre></details></td></tr>}</tbody></table></div></section>