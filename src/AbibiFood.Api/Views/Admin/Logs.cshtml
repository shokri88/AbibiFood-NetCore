@model List<AuditLog>
@{ViewData["Title"]="لاگ عملیات و خطا";var errors=ViewData["Errors"] as List<ErrorLog> ?? [];}
<section class="admin-card"><h2 class="h5">۱۰۰ عملیات اخیر</h2><div class="table-responsive"><table class="table"><thead><tr><th>زمان UTC</th><th>کاربر</th><th>شعبه</th><th>عملیات</th><th>رکورد</th></tr></thead><tbody>@foreach(var x in Model){<tr><td>@x.OccurredAt</td><td>@x.ActorId</td><td>@x.BranchId</td><td>@x.Action</td><td>@x.EntityType / @x.EntityId</td></tr>}</tbody></table></div></section><section class="admin-card mt-4"><h2 class="h5">۱۰۰ خطای اخیر</h2>@foreach(var e in errors){<details><summary>@e.OccurredAt · @e.CorrelationId · @e.ExceptionType</summary><pre dir="ltr">@e.StackTrace</pre></details>}</section>