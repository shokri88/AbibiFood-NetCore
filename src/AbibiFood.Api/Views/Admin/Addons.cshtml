@model AddonInput
@{ViewData["Title"]="افزودنی‌های مجاز";}
<partial name="_BranchFilter"/><section class="admin-card mb-4"><h2 class="card-heading">ثبت و ویرایش اطلاعات</h2><form asp-action="SaveAddon" method="post"><div asp-validation-summary="All" class="text-danger"></div><input asp-for="Id" type="hidden"><input type="hidden" name="branchId" value="@ViewData["BranchId"]"><div class="row g-3"><div class="col-12 col-md-4 col-xl-3"><label asp-for="ParentBranchFoodId" class="form-label">غذای اصلی شعبه</label><select asp-for="ParentBranchFoodId" class="form-select">@foreach(var option in (ViewData["BranchFoods"] as List<BranchFood> ?? [])){<option value="@option.Id">@option.FoodId</option>}</select></div><div class="col-12 col-md-4 col-xl-3"><label asp-for="AddonBranchFoodId" class="form-label">افزودنی از همان مخزن</label><select asp-for="AddonBranchFoodId" class="form-select">@foreach(var option in (ViewData["BranchFoods"] as List<BranchFood> ?? [])){<option value="@option.Id">@option.FoodId</option>}</select></div><div class="col-12 col-md-4 col-xl-3"><label asp-for="MaxQuantity" class="form-label">حداکثر تعداد مجاز</label><input asp-for="MaxQuantity" type="number" class="form-control" step="any"><span asp-validation-for="MaxQuantity" class="text-danger"></span></div><div class="col-12 col-md-4 col-xl-3"><label class="form-check check-field"><input asp-for="IsActive" class="form-check-input">فعال</label></div><div class="col-12 form-footer"><button class="btn btn-primary">ذخیره</button></div></div></form></section>
<partial name="_Rows"/>