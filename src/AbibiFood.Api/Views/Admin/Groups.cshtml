@model GroupInput
@{ViewData["Title"]="گروه‌های شعبه";}
<partial name="_BranchFilter"/><section class="admin-card mb-4"><h2 class="card-heading">ثبت و ویرایش اطلاعات</h2><form asp-action="SaveGroup" method="post" enctype="multipart/form-data"><div asp-validation-summary="All" class="text-danger"></div><input asp-for="Id" type="hidden"><input type="hidden" name="branchId" value="@ViewData["BranchId"]"><div class="row g-3"><input asp-for="BranchId" type="hidden"><div class="col-12 col-md-4 col-xl-3"><label asp-for="Title" class="form-label">عنوان</label><input asp-for="Title" type="text" class="form-control"><span asp-validation-for="Title" class="text-danger"></span></div><div class="col-12 col-md-4 col-xl-3"><label asp-for="ImagePath" class="form-label">مسیر تصویر یا آیکن</label><input asp-for="ImagePath" type="text" class="form-control"><span asp-validation-for="ImagePath" class="text-danger"></span></div><div class="col-12 col-md-4 col-xl-3"><label for="imageFile" class="form-label">بارگذاری تصویر گروه</label><input type="file" id="imageFile" name="imageFile" class="form-control" accept="image/png,image/jpeg,image/webp" data-image-upload><small class="text-secondary">حداکثر ۵ مگابایت؛ جایگزین مسیر تصویر می‌شود.</small></div><div class="col-12 col-md-4 col-xl-3"><label asp-for="SortOrder" class="form-label">ترتیب</label><input asp-for="SortOrder" type="number" class="form-control" step="any"><span asp-validation-for="SortOrder" class="text-danger"></span></div><div class="col-12 col-md-4 col-xl-3"><label class="form-check check-field"><input asp-for="IsActive" class="form-check-input">فعال</label></div><div class="col-12"><button class="btn btn-primary">ذخیره</button></div></div></form></section>
<partial name="_Rows"/>