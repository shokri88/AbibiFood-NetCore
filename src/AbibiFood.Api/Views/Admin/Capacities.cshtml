@model CapacityInput
@{ViewData["Title"]="ظرفیت روزانه";}
<partial name="_BranchFilter"/><section class="admin-card mb-4"><h2 class="card-heading">ثبت و ویرایش اطلاعات</h2><form asp-action="SaveCapacity" method="post"><div asp-validation-summary="All" class="text-danger"></div><input type="hidden" name="branchId" value="@ViewData["BranchId"]"><div class="row g-3"><input asp-for="Version" type="hidden"><div class="col-12 col-md-4 col-xl-3"><label asp-for="BranchFoodId" class="form-label">غذای شعبه</label><select asp-for="BranchFoodId" class="form-select">@foreach(var option in (ViewData["BranchFoods"] as List<BranchFood> ?? [])){<option value="@option.Id">@option.FoodId</option>}</select></div><div class="col-12 col-md-4 col-xl-3"><label for="persianDate" class="form-label">تاریخ شمسی</label><input id="persianDate" name="persianDate" type="text" inputmode="numeric" dir="ltr" class="form-control" value="@PersianDisplay.Date(Model.Date)" placeholder="۱۴۰۵/۰۸/۰۹" required data-persian-date><small class="text-secondary">سال/ماه/روز؛ نمونه: ۱۴۰۵/۰۸/۰۹</small><span asp-validation-for="Date" class="text-danger"></span></div><div class="col-12 col-md-4 col-xl-3"><label asp-for="Total" class="form-label">ظرفیت کل</label><input asp-for="Total" type="number" class="form-control" step="any"><span asp-validation-for="Total" class="text-danger"></span></div><div class="col-12 col-md-4 col-xl-3"><label asp-for="WarningThreshold" class="form-label">آستانه هشدار</label><input asp-for="WarningThreshold" type="number" class="form-control" step="any"><span asp-validation-for="WarningThreshold" class="text-danger"></span></div><div class="col-12 col-md-4 col-xl-3"><label class="form-check check-field"><input asp-for="IsActive" class="form-check-input">ظرفیت فعال</label></div><div class="col-12 form-footer"><button class="btn btn-primary">ذخیره</button></div></div></form></section>
<partial name="_Rows"/>