@model CapacityInput
@{ViewData["Title"]="ظرفیت روزانه";}
<partial name="_BranchFilter"/><section class="admin-card"><form asp-action="SaveCapacity" method="post"><div asp-validation-summary="All" class="text-danger"></div><input type="hidden" name="branchId" value="@ViewData["BranchId"]"><div class="row g-3"><input asp-for="Version" type="hidden"><div class="col-md-6"><label asp-for="BranchFoodId" class="form-label">غذای شعبه</label><select asp-for="BranchFoodId" class="form-select">@foreach(var option in (ViewData["BranchFoods"] as List<BranchFood> ?? [])){<option value="@option.Id">@option.FoodId</option>}</select></div><div class="col-md-6"><label asp-for="Date" class="form-label">تاریخ</label><input asp-for="Date" type="date" class="form-control"><span asp-validation-for="Date" class="text-danger"></span></div><div class="col-md-6"><label asp-for="Total" class="form-label">ظرفیت کل</label><input asp-for="Total" type="number" class="form-control" step="any"><span asp-validation-for="Total" class="text-danger"></span></div><div class="col-md-6"><label asp-for="WarningThreshold" class="form-label">آستانه هشدار</label><input asp-for="WarningThreshold" type="number" class="form-control" step="any"><span asp-validation-for="WarningThreshold" class="text-danger"></span></div><div class="col-md-6"><label class="form-check"><input asp-for="IsActive" class="form-check-input">ظرفیت فعال</label></div><div class="col-12"><button class="btn btn-primary">ذخیره</button></div></div></form><partial name="_Rows"/></section>