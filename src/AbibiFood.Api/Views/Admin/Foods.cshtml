@model FoodInput
@{ViewData["Title"]="مخزن غذا";}
<section class="admin-card mb-4"><h2 class="card-heading">ثبت و ویرایش اطلاعات</h2><form asp-action="SaveFood" method="post"><div asp-validation-summary="All" class="text-danger"></div><input asp-for="Id" type="hidden"><input type="hidden" name="branchId" value="@ViewData["BranchId"]"><div class="row g-3"><div class="col-12 col-md-4 col-xl-3"><label asp-for="Name" class="form-label">نام</label><input asp-for="Name" type="text" class="form-control"><span asp-validation-for="Name" class="text-danger"></span></div><div class="col-12 col-md-4 col-xl-3"><label asp-for="Title" class="form-label">عنوان</label><input asp-for="Title" type="text" class="form-control"><span asp-validation-for="Title" class="text-danger"></span></div><div class="col-12"><label asp-for="Description" class="form-label">توضیحات</label><textarea asp-for="Description" rows="3" class="form-control"></textarea><span asp-validation-for="Description" class="text-danger"></span></div><div class="col-12 col-md-4 col-xl-3"><label class="form-check check-field"><input asp-for="IsActive" class="form-check-input">فعال</label></div><div class="col-12"><button class="btn btn-primary">ذخیره</button></div></div></form></section>
@if(Model.Id > 0){
<section class="admin-card mb-4">
    <h2 class="card-heading">تصاویر @Model.Name</h2>
    <a asp-action="Images" asp-route-foodId="@Model.Id" class="btn btn-primary mb-3">افزودن تصویر از سیستم</a>
    <div class="table-responsive"><table class="table"><thead><tr><th data-no-sort>تصویر</th><th>ترتیب</th><th>وضعیت</th><th data-no-sort>عملیات</th></tr></thead><tbody>
    @foreach(var image in (ViewData["Images"] as List<FoodImage> ?? [])){
        <tr><td><img src="@image.Path" class="image-thumb" alt="تصویر @Model.Name" loading="lazy"></td><td>@image.SortOrder</td><td>@(image.IsActive ? "فعال" : "غیرفعال")</td><td><a asp-action="Images" asp-route-foodId="@Model.Id" asp-route-id="@image.Id" class="btn btn-outline-primary btn-sm">ویرایش تصویر</a></td></tr>
    }
    </tbody></table></div>
</section>
}else{<p class="text-secondary">برای افزودن تصاویر، ابتدا غذا را ذخیره کنید.</p>}
<a asp-action="Foods" class="btn btn-outline-primary mb-3">تعریف غذای جدید</a>
<partial name="_Rows"/>