@model List<AppUser>
@{ViewData["Title"]="کارکنان و دسترسی شعبه";var branches=ViewData["Branches"] as List<Branch> ?? [];var staff=ViewData["Staff"] as List<StaffBranch> ?? [];}
<div class="admin-card mb-4"><h2 class="h5">تعریف کارمند</h2><form asp-action="CreateEmployee" method="post"><div class="row g-3"><div class="col-md-4"><label class="form-label" for="displayName">نام</label><input name="displayName" id="displayName" class="form-control" required></div><div class="col-md-4"><label class="form-label" for="email">ایمیل</label><input type="email" name="email" id="email" class="form-control" required></div><div class="col-md-4"><label class="form-label" for="password">رمز اولیه قوی</label><input type="password" name="password" id="password" class="form-control" minlength="12" required autocomplete="new-password"></div><div class="col-12 form-footer"><button class="btn btn-primary">ایجاد کارمند</button></div></div></form></div>
<div class="admin-card"><h2 class="h5">اختصاص یا غیرفعال‌کردن دسترسی شعبه</h2><form asp-action="AssignBranch" method="post"><div class="row g-3"><div class="col-md-4"><label for="assign-user" class="form-label">کارمند</label><select id="assign-user" name="userId" class="form-select" aria-label="کاربر">@foreach(var u in Model){<option value="@u.Id">@u.DisplayName · @u.Email</option>}</select></div><div class="col-md-4"><label for="assign-branch" class="form-label">شعبه</label><select id="assign-branch" name="branchId" class="form-select" aria-label="شعبه">@foreach(var b in branches){<option value="@b.Id">@b.Name</option>}</select></div><div class="col-md-3"><label class="check-field"><input type="checkbox" name="isActive" value="true" checked>دسترسی فعال</label></div><div class="col-12 form-footer"><button class="btn btn-primary">ذخیره دسترسی</button></div></div></form></div>
<div class="admin-card mt-4"><h2 class="h5">فعال یا غیرفعال‌کردن کارمند</h2><form asp-action="SetEmployeeActive" method="post"><div class="row g-3"><div class="col-md-4"><label for="active-user" class="form-label">کارمند</label><select id="active-user" class="form-select" name="userId" aria-label="کارمند">@foreach(var u in Model){<option value="@u.Id">@u.DisplayName · @(u.IsActive?"فعال":"غیرفعال")</option>}</select></div><div class="col-md-3"><label class="check-field"><input type="checkbox" name="isActive" value="true" checked>کاربر فعال</label></div><div class="col-12 form-footer"><button class="btn btn-primary">ذخیره</button></div></div></form></div>
<section class="admin-card mt-4"><h2 class="card-heading">فهرست دسترسی شعب</h2>
<div class="table-responsive"><table class="table"><thead><tr><th>کارمند</th><th>شعبه</th><th>وضعیت دسترسی</th><th data-no-sort>عملیات</th></tr></thead><tbody>
@foreach(var mapping in staff){<tr><td>@(Model.FirstOrDefault(x => x.Id == mapping.UserId)?.DisplayName ?? mapping.UserId)</td><td>@(branches.FirstOrDefault(x => x.Id == mapping.BranchId)?.Name ?? mapping.BranchId.ToString())</td><td>@(mapping.IsActive ? "فعال" : "غیرفعال")</td><td><partial name="_DeleteButton" model='new DeleteButton("StaffBranch", mapping.Id.ToString(), "/Admin/Employees")'/></td></tr>}
</tbody></table></div></section>

<section class="admin-card mt-4"><h2 class="card-heading">فهرست کارکنان</h2>
<div class="table-responsive"><table class="table"><thead><tr><th>نام</th><th>ایمیل</th><th>وضعیت</th><th data-no-sort>عملیات</th></tr></thead><tbody>
@foreach(var employee in Model){<tr><td>@employee.DisplayName</td><td data-no-localize>@employee.Email</td><td>@(employee.IsActive ? "فعال" : "غیرفعال")</td><td><partial name="_DeleteButton" model='new DeleteButton("Employee", employee.Id, "/Admin/Employees")'/></td></tr>}
</tbody></table></div></section>
