@model List<AppUser>
@{ViewData["Title"]="کارکنان و دسترسی شعبه";var branches=ViewData["Branches"] as List<Branch> ?? [];var staff=ViewData["Staff"] as List<StaffBranch> ?? [];}
<div class="admin-card mb-4"><h2 class="h5">تعریف کارمند</h2><form asp-action="CreateEmployee" method="post"><div class="row g-3"><div class="col-md-4"><label class="form-label" for="displayName">نام</label><input name="displayName" id="displayName" class="form-control" required></div><div class="col-md-4"><label class="form-label" for="email">ایمیل</label><input type="email" name="email" id="email" class="form-control" required></div><div class="col-md-4"><label class="form-label" for="password">رمز اولیه قوی</label><input type="password" name="password" id="password" class="form-control" minlength="12" required autocomplete="new-password"></div><div class="col-12"><button class="btn btn-primary">ایجاد کارمند</button></div></div></form></div>
<div class="admin-card"><h2 class="h5">اختصاص یا غیرفعال‌کردن دسترسی شعبه</h2><form asp-action="AssignBranch" method="post"><div class="row g-3"><div class="col-md-5"><select name="userId" class="form-select" aria-label="کاربر">@foreach(var u in Model){<option value="@u.Id">@u.DisplayName · @u.Email</option>}</select></div><div class="col-md-4"><select name="branchId" class="form-select" aria-label="شعبه">@foreach(var b in branches){<option value="@b.Id">@b.Name</option>}</select></div><div class="col-md-3"><label><input type="checkbox" name="isActive" value="true" checked>دسترسی فعال</label></div><div class="col-12"><button class="btn btn-primary">ذخیره دسترسی</button></div></div></form><hr>@foreach(var s in staff){<p>@s.UserId · شعبه @s.BranchId · @(s.IsActive?"فعال":"غیرفعال")</p>}</div>
<div class="admin-card mt-4"><h2 class="h5">فعال یا غیرفعال‌کردن کارمند</h2><form asp-action="SetEmployeeActive" method="post"><div class="row g-3"><div class="col-md-7"><select class="form-select" name="userId" aria-label="کارمند">@foreach(var u in Model){<option value="@u.Id">@u.DisplayName · @(u.IsActive?"فعال":"غیرفعال")</option>}</select></div><div class="col-md-3"><label><input type="checkbox" name="isActive" value="true" checked>کاربر فعال</label></div><div class="col-auto"><button class="btn btn-primary">ذخیره</button></div></div></form></div>