@model GroupFoodInput
@{ViewData["Title"]="عضویت غذا در گروه";}
<partial name="_BranchFilter"/><section class="admin-card"><form asp-action="SaveGroupFood" method="post"><div asp-validation-summary="All" class="text-danger"></div><input asp-for="Id" type="hidden"><input type="hidden" name="branchId" value="@ViewData["BranchId"]"><div class="row g-3"><div class="col-md-6"><label asp-for="BranchGroupId" class="form-label">گروه</label><select asp-for="BranchGroupId" class="form-select">@foreach(var option in (ViewData["Groups"] as List<BranchGroup> ?? [])){<option value="@option.Id">@option.Title</option>}</select></div><div class="col-md-6"><label asp-for="BranchFoodId" class="form-label">شناسه غذای شعبه</label><select asp-for="BranchFoodId" class="form-select">@foreach(var option in (ViewData["BranchFoods"] as List<BranchFood> ?? [])){<option value="@option.Id">@option.FoodId</option>}</select></div><div class="col-md-6"><label asp-for="SortOrder" class="form-label">ترتیب</label><input asp-for="SortOrder" type="number" class="form-control" step="any"><span asp-validation-for="SortOrder" class="text-danger"></span></div><div class="col-md-6"><label class="form-check"><input asp-for="IsActive" class="form-check-input">فعال</label></div><div class="col-12"><button class="btn btn-primary">ذخیره</button></div></div></form><partial name="_Rows"/></section>