@model GroupFoodInput
@{ViewData["Title"]="عضویت غذا در گروه";}
<partial name="_BranchFilter"/>
@if ((ViewData["BranchFoods"] as List<BranchFood> ?? []).Count == 0) {
<div class="alert alert-info">برای این شعبه غذایی تخصیص داده نشده است. پس از ثبت غذا در مخزن، آن را در <a asp-action="Menu" asp-route-branchId='@ViewData["BranchId"]'>منوی شعبه</a> انتخاب و قیمت‌گذاری کنید؛ سپس به این صفحه برگردید.</div>
}
<section class="admin-card mb-4"><h2 class="card-heading">ثبت و ویرایش اطلاعات</h2><form asp-action="SaveGroupFood" method="post"><div asp-validation-summary="All" class="text-danger"></div><input asp-for="Id" type="hidden"><input type="hidden" name="branchId" value="@ViewData["BranchId"]"><div class="row g-3"><div class="col-12 col-md-4 col-xl-3"><label asp-for="BranchGroupId" class="form-label">گروه</label><select asp-for="BranchGroupId" class="form-select">@foreach(var option in (ViewData["Groups"] as List<BranchGroup> ?? [])){<option value="@option.Id">@option.Title</option>}</select></div><div class="col-12 col-md-4 col-xl-3"><label asp-for="BranchFoodId" class="form-label">غذای شعبه</label><select asp-for="BranchFoodId" class="form-select">@foreach(var option in (ViewData["BranchFoods"] as List<BranchFood> ?? [])){<option value="@option.Id">@option.Food.Name</option>}</select></div><div class="col-12 col-md-4 col-xl-3"><label asp-for="SortOrder" class="form-label">ترتیب</label><input asp-for="SortOrder" type="number" class="form-control" step="any"><span asp-validation-for="SortOrder" class="text-danger"></span></div><div class="col-12 col-md-4 col-xl-3"><label class="form-check check-field"><input asp-for="IsActive" class="form-check-input">فعال</label></div><div class="col-12 form-footer"><button class="btn btn-primary">ذخیره</button></div></div></form></section>
<partial name="_Rows"/>