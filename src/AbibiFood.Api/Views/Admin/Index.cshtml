@model List<DailyCapacity>
@{ViewData["Title"]="داشبورد مدیریت";}
<partial name="_BranchFilter"/><div class="row g-3 mb-4"><div class="col-md-4"><div class="admin-card"><h2 class="h6">ظرفیت‌های باز و آینده</h2><strong class="display-6">@Model.Count(x=>x.IsActive)</strong></div></div><div class="col-md-4"><div class="admin-card"><h2 class="h6">رو به اتمام</h2><strong class="display-6">@Model.Count(x=>x.IsActive&&x.Remaining<=x.WarningThreshold)</strong></div></div><div class="col-md-4"><div class="admin-card"><h2 class="h6">فروش و سفارش‌ها</h2><p>ماژول فروش در فاز یک فعال نیست؛ آماری جعل نمی‌شود.</p></div></div></div><section class="admin-card"><h2 class="h5">وضعیت ظرفیت</h2><div class="table-responsive"><table class="table"><thead><tr><th>غذای شعبه</th><th>تاریخ</th><th>کل</th><th>رزرو</th><th>فروش</th><th>باقی‌مانده</th></tr></thead><tbody>@foreach(var c in Model){<tr class="@(c.Remaining<=c.WarningThreshold?"table-warning":"")"><td>@c.BranchFoodId</td><td>@c.Date</td><td>@c.Total</td><td>@c.Reserved</td><td>@c.Sold</td><td>@c.Remaining</td></tr>}</tbody></table></div></section>