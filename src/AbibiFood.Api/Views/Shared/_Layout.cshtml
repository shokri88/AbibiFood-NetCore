<!doctype html><html lang="fa" dir="rtl"><head><meta charset="utf-8"><meta name="viewport" content="width=device-width,initial-scale=1"><title>@ViewData["Title"] | مدیریت آبی‌بی</title><link rel="stylesheet" href="~/assets/vendor/bootstrap/bootstrap.rtl.min.css"><link rel="stylesheet" href="~/assets/css/admin.css" asp-append-version="true"><link rel="stylesheet" href="~/assets/css/vazir.css" asp-append-version="true"></head><body><header class="border-bottom bg-white"><div class="container-fluid px-4 py-3 d-flex align-items-center justify-content-between"><a href="/Admin" class="brand">آبی‌بی · پنل مدیریت</a><span>@User.Identity?.Name</span>@if(User.Identity?.IsAuthenticated==true){<form asp-controller="Account" asp-action="Logout" method="post"><button class="btn btn-outline-danger btn-sm">خروج</button></form>}</div></header><div class="container-fluid p-3 p-lg-4"><div class="row g-4">@if(User.Identity?.IsAuthenticated==true){<aside class="col-lg-2"><nav class="admin-nav" aria-label="منوی مدیریت">
    <div class="nav-caption">فضای مدیریت</div>
    <details open><summary>نمای کلی و نظارت</summary>
        <a href="/Admin/Index">داشبورد</a>
        @if(User.IsInRole("Manager")){<a href="/Admin/Logs">گزارش عملیات و خطا</a>}
    </details>
    @if(User.IsInRole("Manager")){
    <details open><summary>کاتالوگ و منو</summary>
        <a href="/Admin/Foods">مخزن غذا و تصاویر</a><a href="/Admin/Groups">گروه‌های غذایی</a>
        <a href="/Admin/Menu">غذا و قیمت شعبه</a><a href="/Admin/Memberships">غذاهای هر گروه</a><a href="/Admin/Addons">افزودنی‌های مجاز</a>
    </details>}
    <details open><summary>عملیات شعب</summary>
        <a href="/Admin/Capacities">ظرفیت روزانه</a>
        @if(User.IsInRole("Manager")){<a href="/Admin/Branches">مدیریت شعب</a><a href="/Admin/Hours">ساعات فعالیت</a>}
    </details>
    @if(User.IsInRole("Manager")){<details open><summary>کاربران و دسترسی</summary><a href="/Admin/Employees">کارکنان و دسترسی شعب</a></details>}
</nav></aside>}<main class="@(User.Identity?.IsAuthenticated==true?"col-lg-10":"col-12")"><h1 class="h3 mb-4">@ViewData["Title"]</h1>@if(TempData["Success"] is string notice){<div class="alert alert-success">@notice</div>}@if(TempData["Error"] is string error){<div class="alert alert-danger" role="alert">@error</div>}@RenderBody()</main></div></div><script src="~/assets/vendor/bootstrap/bootstrap.bundle.min.js"></script><script src="~/assets/vendor/just-validate/just-validate.production.min.js"></script><script src="~/assets/js/admin-validation.js"></script><script src="~/assets/js/admin-ui.js" asp-append-version="true"></script>@await RenderSectionAsync("Scripts",required:false)</body></html>