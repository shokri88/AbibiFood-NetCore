<!doctype html><html lang="fa" dir="rtl"><head><meta charset="utf-8"><meta name="viewport" content="width=device-width,initial-scale=1"><title>@ViewData["Title"] | مدیریت آبی‌بی</title><link rel="stylesheet" href="~/assets/vendor/bootstrap/bootstrap.rtl.min.css"><link rel="stylesheet" href="~/assets/css/admin.css"><link rel="stylesheet" href="~/assets/css/vazir.css" asp-append-version="true"></head><body><header class="border-bottom bg-white"><div class="container-fluid px-4 py-3 d-flex align-items-center justify-content-between"><a href="/Admin" class="brand">آبی‌بی · پنل مدیریت</a><span>@User.Identity?.Name</span>@if(User.Identity?.IsAuthenticated==true){<form asp-controller="Account" asp-action="Logout" method="post"><button class="btn btn-outline-danger btn-sm">خروج</button></form>}</div></header><div class="container-fluid p-3 p-lg-4"><div class="row g-4">@if(User.Identity?.IsAuthenticated==true){<aside class="col-lg-2"><nav class="admin-nav"><a href="/Admin/Index">داشبورد</a>@if(User.IsInRole("Manager")){<a href="/Admin/Branches">شعب</a>}@if(User.IsInRole("Manager")){<a href="/Admin/Foods">مخزن غذا</a>}@if(User.IsInRole("Manager")){<a href="/Admin/Images">تصاویر غذا</a>}@if(User.IsInRole("Manager")){<a href="/Admin/Groups">گروه‌ها</a>}@if(User.IsInRole("Manager")){<a href="/Admin/Menu">غذای شعبه</a>}@if(User.IsInRole("Manager")){<a href="/Admin/Memberships">غذاهای گروه</a>}@if(User.IsInRole("Manager")){<a href="/Admin/Addons">افزودنی‌ها</a>}<a href="/Admin/Capacities">ظرفیت روزانه</a>@if(User.IsInRole("Manager")){<a href="/Admin/Hours">ساعات شعبه</a>}@if(User.IsInRole("Manager")){<a href="/Admin/Employees">کارکنان</a>}@if(User.IsInRole("Manager")){<a href="/Admin/Logs">لاگ‌ها</a>}</nav></aside>}<main class="@(User.Identity?.IsAuthenticated==true?"col-lg-10":"col-12")"><h1 class="h3 mb-4">@ViewData["Title"]</h1>@if(TempData["Success"] is string notice){<div class="alert alert-success">@notice</div>}@RenderBody()</main></div></div><script src="~/assets/vendor/bootstrap/bootstrap.bundle.min.js"></script><script src="~/assets/vendor/just-validate/just-validate.production.min.js"></script><script src="~/assets/js/admin-validation.js"></script>@await RenderSectionAsync("Scripts",required:false)</body></html>